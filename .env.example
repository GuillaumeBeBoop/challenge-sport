# Le code d'accès partagé entre les deux joueurs. Seule variable obligatoire.
ACCESS_CODE=change-moi

# Le cookie de session suit le protocole de la requête : Secure en HTTPS,
# non-Secure en HTTP simple (réseau local, test). Ces deux lignes ne servent
# qu'à forcer le comportement.
# COOKIE_SECURE=true
# COOKIE_SECURE=false
